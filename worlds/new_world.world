<?xml version="1.0"?>
<sdf version="1.6">
  <world name="assignment3_new_world">
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <light name="sun" type="directional">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.4 0.3 -1</direction>
    </light>

    <scene>
      <ambient>0.45 0.45 0.45 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <grid>false</grid>
      <shadows>false</shadows>
    </scene>

    <physics type="ode">
      <real_time_update_rate>1000.0</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <ode>
        <solver>
          <type>quick</type>
          <iters>150</iters>
          <sor>1.4</sor>
        </solver>
        <constraints>
          <cfm>0.00001</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>2000.0</contact_max_correcting_vel>
          <contact_surface_layer>0.01</contact_surface_layer>
        </constraints>
      </ode>
    </physics>

    <model name="gray_gazebo_floor">
      <static>true</static>
      <pose>0 0 -0.025 0 0 0</pose>
      <link name="floor_link">
        <collision name="floor_collision">
          <geometry>
            <box>
              <size>8.0 6.0 0.02</size>
            </box>
          </geometry>
        </collision>
        <visual name="floor_visual">
          <geometry>
            <box>
              <size>8.0 6.0 0.02</size>
            </box>
          </geometry>
          <material>
            <ambient>0.48 0.48 0.48 1</ambient>
            <diffuse>0.55 0.55 0.55 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <include>
      <uri>model://robocup_2009_spl_field</uri>
      <pose>0 0 0 0 0 0</pose>
    </include>

    <include>
      <name>cone_1</name>
      <uri>model://construction_cone</uri>
      <pose>-1.75 -0.85 0.03 0 0 0</pose>
    </include>
    <include>
      <name>cone_2</name>
      <uri>model://construction_cone</uri>
      <pose>-1.10 0.75 0.03 0 0 0.2</pose>
    </include>
    <include>
      <name>cone_3</name>
      <uri>model://construction_cone</uri>
      <pose>-0.25 -0.20 0.03 0 0 -0.1</pose>
    </include>
    <include>
      <name>cone_4</name>
      <uri>model://construction_cone</uri>
      <pose>0.55 0.95 0.03 0 0 0.5</pose>
    </include>
    <include>
      <name>cone_5</name>
      <uri>model://construction_cone</uri>
      <pose>1.20 -0.65 0.03 0 0 -0.4</pose>
    </include>
    <include>
      <name>cone_6</name>
      <uri>model://construction_cone</uri>
      <pose>1.95 0.55 0.03 0 0 0.35</pose>
    </include>
    <include>
      <name>cone_7</name>
      <uri>model://construction_cone</uri>
      <pose>0.25 -1.25 0.03 0 0 0.15</pose>
    </include>
    <include>
      <name>cone_8</name>
      <uri>model://construction_cone</uri>
      <pose>-2.15 1.20 0.03 0 0 -0.25</pose>
    </include>
  </world>
</sdf>
