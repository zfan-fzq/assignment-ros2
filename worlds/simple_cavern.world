<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="simple_cavern">
    <physics name="step" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>

    <gui fullscreen="false">
      <plugin filename="MinimalScene" name="3D View">
        <gz-gui><title>简易地下洞室导航训练场</title></gz-gui>
        <engine>ogre2</engine>
        <scene>scene</scene>
        <ambient_light>0.35 0.37 0.42</ambient_light>
        <background_color>0.08 0.09 0.12</background_color>
        <camera_pose>0 4 38 0 1.5707 0</camera_pose>
      </plugin>
      <plugin filename="EntityContextMenuPlugin" name="Entity context menu">
        <gz-gui><property key="state" type="string">floating</property><property key="width" type="double">5</property><property key="height" type="double">5</property><property key="showTitleBar" type="bool">false</property></gz-gui>
      </plugin>
      <plugin filename="GzSceneManager" name="Scene Manager">
        <gz-gui><property key="state" type="string">floating</property><property key="width" type="double">5</property><property key="height" type="double">5</property><property key="showTitleBar" type="bool">false</property></gz-gui>
      </plugin>
      <plugin filename="InteractiveViewControl" name="Interactive view control">
        <gz-gui><property key="state" type="string">floating</property><property key="width" type="double">5</property><property key="height" type="double">5</property><property key="showTitleBar" type="bool">false</property></gz-gui>
      </plugin>
      <plugin filename="CameraTracking" name="Camera Tracking">
        <gz-gui><property key="state" type="string">floating</property><property key="width" type="double">5</property><property key="height" type="double">5</property><property key="showTitleBar" type="bool">false</property></gz-gui>
      </plugin>
    </gui>

    <scene>
      <ambient>0.35 0.37 0.42 1</ambient>
      <background>0.08 0.09 0.12 1</background>
      <shadows>true</shadows>
    </scene>
    <light type="directional" name="work_light">
      <pose>0 0 18 0 0 0</pose>
      <diffuse>0.75 0.78 0.85 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.3 0.2 -1</direction>
    </light>

    <!-- Main passage: 30 m long and 6 m wide -->
    <model name="main_floor"><static>true</static><link name="link"><pose>0 0 -0.1 0 0 0</pose>
      <collision name="collision"><geometry><box><size>30 6 0.2</size></box></geometry></collision>
      <visual name="visual"><geometry><box><size>30 6 0.2</size></box></geometry><material><ambient>0.24 0.25 0.27 1</ambient><diffuse>0.34 0.35 0.37 1</diffuse></material></visual>
    </link></model>
    <!-- T branch floor -->
    <model name="branch_floor"><static>true</static><link name="link"><pose>6 9 -0.1 0 0 0</pose>
      <collision name="collision"><geometry><box><size>4 12 0.2</size></box></geometry></collision>
      <visual name="visual"><geometry><box><size>4 12 0.2</size></box></geometry><material><ambient>0.24 0.25 0.27 1</ambient><diffuse>0.34 0.35 0.37 1</diffuse></material></visual>
    </link></model>

    <!-- Concrete walls; north wall has a 4 m opening into the branch -->
    <model name="south_wall"><static>true</static><link name="link"><pose>0 -3 1.5 0 0 0</pose><collision name="c"><geometry><box><size>30 0.3 3</size></box></geometry></collision><visual name="v"><geometry><box><size>30 0.3 3</size></box></geometry><material><diffuse>0.46 0.48 0.52 1</diffuse></material></visual></link></model>
    <model name="north_wall_left"><static>true</static><link name="link"><pose>-5.5 3 1.5 0 0 0</pose><collision name="c"><geometry><box><size>19 0.3 3</size></box></geometry></collision><visual name="v"><geometry><box><size>19 0.3 3</size></box></geometry><material><diffuse>0.46 0.48 0.52 1</diffuse></material></visual></link></model>
    <model name="north_wall_right"><static>true</static><link name="link"><pose>11.5 3 1.5 0 0 0</pose><collision name="c"><geometry><box><size>7 0.3 3</size></box></geometry></collision><visual name="v"><geometry><box><size>7 0.3 3</size></box></geometry><material><diffuse>0.46 0.48 0.52 1</diffuse></material></visual></link></model>
    <model name="west_end"><static>true</static><link name="link"><pose>-15 0 1.5 0 0 0</pose><collision name="c"><geometry><box><size>0.3 6 3</size></box></geometry></collision><visual name="v"><geometry><box><size>0.3 6 3</size></box></geometry><material><diffuse>0.46 0.48 0.52 1</diffuse></material></visual></link></model>
    <model name="east_end"><static>true</static><link name="link"><pose>15 0 1.5 0 0 0</pose><collision name="c"><geometry><box><size>0.3 6 3</size></box></geometry></collision><visual name="v"><geometry><box><size>0.3 6 3</size></box></geometry><material><diffuse>0.46 0.48 0.52 1</diffuse></material></visual></link></model>
    <model name="branch_west"><static>true</static><link name="link"><pose>4 9 1.5 0 0 0</pose><collision name="c"><geometry><box><size>0.3 12 3</size></box></geometry></collision><visual name="v"><geometry><box><size>0.3 12 3</size></box></geometry><material><diffuse>0.46 0.48 0.52 1</diffuse></material></visual></link></model>
    <model name="branch_east"><static>true</static><link name="link"><pose>8 9 1.5 0 0 0</pose><collision name="c"><geometry><box><size>0.3 12 3</size></box></geometry></collision><visual name="v"><geometry><box><size>0.3 12 3</size></box></geometry><material><diffuse>0.46 0.48 0.52 1</diffuse></material></visual></link></model>
    <model name="branch_end"><static>true</static><link name="link"><pose>6 15 1.5 0 0 0</pose><collision name="c"><geometry><box><size>4 0.3 3</size></box></geometry></collision><visual name="v"><geometry><box><size>4 0.3 3</size></box></geometry><material><diffuse>0.46 0.48 0.52 1</diffuse></material></visual></link></model>

    <!-- Navigation landmarks / obstacles -->
    <model name="obstacle_crate_1"><static>true</static><pose>-2 1.2 0 0 0 0</pose><link name="link"><pose>0 0 0.55 0 0 0</pose><collision name="c"><geometry><box><size>1.1 1.1 1.1</size></box></geometry></collision><visual name="v"><geometry><box><size>1.1 1.1 1.1</size></box></geometry><material><diffuse>0.72 0.38 0.12 1</diffuse></material></visual></link></model>
    <model name="obstacle_crate_2"><static>true</static><pose>10 -1.25 0 0 0 0</pose><link name="link"><pose>0 0 0.45 0 0 0</pose><collision name="c"><geometry><box><size>1.3 0.9 0.9</size></box></geometry></collision><visual name="v"><geometry><box><size>1.3 0.9 0.9</size></box></geometry><material><diffuse>0.8 0.55 0.12 1</diffuse></material></visual></link></model>
    <model name="branch_pillar"><static>true</static><pose>6 11 0 0 0 0</pose><link name="link"><pose>0 0 0.8 0 0 0</pose><collision name="c"><geometry><cylinder><radius>0.45</radius><length>1.6</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.45</radius><length>1.6</length></cylinder></geometry><material><diffuse>0.75 0.25 0.12 1</diffuse></material></visual></link></model>
    <model name="start_marker"><static>true</static><pose>-12 0 0.012 0 0 0</pose><link name="link"><visual name="v"><geometry><cylinder><radius>0.65</radius><length>0.02</length></cylinder></geometry><material><emissive>0.05 0.65 0.18 1</emissive><diffuse>0.05 0.65 0.18 1</diffuse></material></visual></link></model>
  </world>
</sdf>
